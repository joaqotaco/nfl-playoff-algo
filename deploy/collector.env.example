# Installed to /etc/nfl-collector.env. Fill in the values, never commit them.

# Pinged after each round. Create a check with period 30m and grace 35m, so you're
# alerted after about two missed rounds. Failed rounds ping <url>/fail.
HEALTHCHECK_URL=

# Backblaze B2 backup. Use an application key limited to one bucket.
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
BACKUP_REMOTE=b2:YOUR-BUCKET-NAME/raw
# Create a separate check with period 1h and grace 2h.
BACKUP_HEALTHCHECK_URL=

# Pinged after each daily fair-value run. Create a check with period 1 day and grace 2h.
FAIRVALUE_HEALTHCHECK_URL=

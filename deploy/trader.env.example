# Installed to /etc/nfl-trader.env (root:trader, 640). Never commit real values.

# demo until you deliberately switch. Production also needs TRADER_ALLOW_PRODUCTION=yes.
KALSHI_ENV=demo
KALSHI_KEY_ID=
KALSHI_KEY_FILE=/etc/nfl-trader/kalshi-demo.pem
TRADER_ALLOW_PRODUCTION=no

# Empty means dry run: print the plan, send nothing. Set to --live to send orders.
TRADER_FLAGS=

# Optional: pinged after each run, /fail if an order's outcome was unknown.
TRADER_HEALTHCHECK_URL=
